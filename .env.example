# Asus router connection
ASUS_HOST=192.168.50.1
ASUS_USER=admin
ASUS_PASS=changeme
ASUS_USE_SSL=true
ASUS_VERIFY_SSL=false

# Comma-separated CIDRs allowed to call the API
LAN_CIDRS=192.168.50.0/24

# Cooldown after a successful trigger (seconds)
COOLDOWN_SECONDS=300

# HTTP server bind
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8080

LOG_LEVEL=INFO
